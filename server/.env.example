# Copy this file to `.env` and fill in real values. `.env` is gitignored; this
# template is not — never put a real secret in here.
#
#   cp .env.example .env

# Port the API listens on. Render sets this itself; locally 3000 matches the
# extension's hardcoded API constant.
PORT=3000

# Google Cloud → APIs & Services → Credentials → your OAuth 2.0 Client ID.
# The same client is used locally and in production; add BOTH redirect URIs to
# it (http://localhost:3000/auth/google/callback and the deployed one).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Signs the app's own 30-day tokens. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing this invalidates every issued token, so everyone re-connects.
JWT_SECRET=

# Postgres connection string. Neon: use the POOLED URL (host contains
# "-pooler") — the free tier limits concurrent connections. Keep ?sslmode=require.
#   postgresql://user:pass@ep-xxx-pooler.<region>.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# The Chrome extension's ID, used as the CORS allowlist in src/index.js.
# Found on chrome://extensions. Defaults to the current unpacked ID if unset.
EXTENSION_ID=ikckplflpjebbfeppemcpkpmnkpilicn
